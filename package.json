{
  "name": "house-cleaning-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite --config web/vite.config.ts",
    "dev:api": "wrangler dev",
    "build": "vite build --config web/vite.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply hcm-db --local",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "npm run build && node --test --test-concurrency=1 tests/e2e/ui.e2e.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  },
  "engines": {
    "node": ">=22.5"
  }
}
